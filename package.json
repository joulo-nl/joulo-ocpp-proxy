{
  "name": "joulo-ocpp-proxy",
  "version": "1.0.0",
  "description": "Lightweight OCPP 1.6/2.0.1 WebSocket proxy that forwards charger traffic to a primary CSMS and mirrors it to one or more secondary backends.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js"
  },
  "keywords": [
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0",
    "ev-charging",
    "websocket",
    "proxy",
    "csms",
    "electric-vehicle",
    "charge-point"
  ],
  "author": "Joulo B.V. <info@joulo.nl> (https://joulo.nl)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joulo-nl/joulo-ocpp-proxy.git"
  },
  "homepage": "https://github.com/joulo-nl/joulo-ocpp-proxy",
  "bugs": {
    "url": "https://github.com/joulo-nl/joulo-ocpp-proxy/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  }
}
